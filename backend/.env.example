# ===== App =====
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_GLOBAL_PREFIX=api

# ===== Database =====
DATABASE_URL="postgresql://aibos:aibos_secret_2026@localhost:5432/aibos?schema=public"

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
# Min 16 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-development-jwt-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-development-refresh-secret-min-16-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ===== AI Providers =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini

# ===== Storage (S3 / MinIO) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aibos-uploads
S3_ACCESS_KEY=aibos_minio
S3_SECRET_KEY=aibos_minio_secret_2026
S3_FORCE_PATH_STYLE=true

# ===== Mail (SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AIBOS <[email protected]>"

# ===== Security =====
# 32+ chars for AES-256
ENCRYPTION_KEY=change-me-32-character-encryption-key-here
MAX_FILE_SIZE=20971520

# ===== Rate limit =====
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ===== Logging =====
LOG_LEVEL=info
