# ===== AIBOS Staging — Environment Variables =====
#
# THIS FILE IS TEMPLATED. Copy to .env.staging (gitignored) and fill
# in real values. Never commit the populated .env.staging.
#
# Required secrets are documented in /docs/secrets.md (Phase 11.4).
# Generate strong secrets with:
#   openssl rand -hex 32
#   openssl rand -hex 64   (for JWT secrets)
#
# This file maps 1-to-1 to env.ts (backend/src/config/env.ts).
# Any change there must be reflected here.

# ===== App =====
NODE_ENV=staging
PORT=3001
FRONTEND_URL=https://staging.aibos.example.com
API_GLOBAL_PREFIX=api

# ===== Database =====
# Format: postgresql://USER:PASS@HOST:PORT/DB?schema=public
# In docker-compose.staging.yml, HOST is the service name "postgres".
DATABASE_URL=postgresql://aibos:CHANGE_ME@postgres:5432/aibos?schema=public

# ===== Redis =====
# Service name in docker network: "redis"
REDIS_HOST=redis
REDIS_PORT=6379
# Generated at first deploy (see /docs/secrets.md), required in staging.
REDIS_PASSWORD=CHANGE_ME

# ===== JWT =====
# Two distinct secrets, generated with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ===== AI Providers =====
# At least one of the three must be set in staging.
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini

# ===== Storage (S3 / MinIO) =====
# Internal endpoint (docker network). Public access is via Nginx.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
# Use a bucket name distinct from dev to avoid accidental data overlap.
S3_BUCKET=aibos-uploads-staging
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# ===== Mail (SMTP) =====
# Staging typically uses Mailgun/SendGrid with a verified sender.
# In dev, MailHog/Mailpit is used (see docker-compose.yml).
SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="AIBOS Staging <[email protected]>"

# ===== Security =====
# 64 hex chars (32 bytes) for AES-256-GCM credential encryption.
# Generated with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
# 20 MB default
MAX_FILE_SIZE=20971520

# ===== Rate limit =====
# Slightly stricter than dev to limit abuse on a public staging URL.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ===== Logging =====
# In staging, "info" is the right default. JSON logs go to stdout
# (collected by docker/journald). Avoid "debug" in staging.
LOG_LEVEL=info
